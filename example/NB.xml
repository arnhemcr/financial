<!-- The CSV record format of the fictional National Bank's financial statements.-->
<CSVRecordFormat>
  <NFields>15</NFields><!-- The number of fields in the record. -->

  <!--
    The indexes of fields in the record.
    Index values are 1..NFields inclusive or
    zero if this field is not contained in these records.
    -->
  <ThisAccountI>1</ThisAccountI>
  <DateI>2</DateI>
  <MemoI>3</MemoI>
  <CodeI>4</CodeI>
  <OtherAccountI>12</OtherAccountI>
  <AmountI>15</AmountI>
  <!--
    The remaining fields are credit, debit and currency.
    As the record has the amount field, credit and debit are not needed.
    The currency field is not contained in these records.
    Indexes for these fields default to zero.
    -->

  <!-- How the Go reference date 2 January 2006 would be laid out in these records. -->
  <DateLayout>02-01-2006</DateLayout>
</CSVRecordFormat>
